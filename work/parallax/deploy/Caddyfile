# One canonical origin serves both the app and /api. Do not rewrite Origin:
# backend CSRF and wallet signatures depend on the browser's real origin.
{$ROPAD_DOMAIN} {
  encode zstd gzip
  header -Server
  reverse_proxy app:61281 {
    header_up Host {$ROPAD_DOMAIN}
    # Stream SSE immediately; WebSocket upgrades are handled by Caddy itself.
    flush_interval -1
    transport http {
      dial_timeout 5s
      response_header_timeout 300s
      read_timeout 600s
      write_timeout 600s
    }
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
    health_status 200
    health_headers {
      Host {$ROPAD_DOMAIN}
    }
  }
}

# Keep wallet sessions on the canonical origin when visitors use www.
www.{$ROPAD_DOMAIN} {
  redir https://{$ROPAD_DOMAIN}{uri} permanent
}
