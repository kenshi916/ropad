# Copy to .env locally on the selected deployment host. Do not commit .env.
# ropad.fun matches the current Studio worker HTTPS allowlist.
ROPAD_DOMAIN=ropad.fun
ROPAD_PUBLIC_ORIGIN=https://ropad.fun
# Keep disabled until the creator explicitly chooses reviewed mainnet operation.
ROPAD_SOLANA_MAINNET_ENABLED=0
ROPAD_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public operator wallet address list and stable provider account label.
ROPAD_OPERATOR_WALLETS=
ROPAD_PROVIDER_ACCOUNT_ID=
# Server-only secrets. Every example is intentionally empty.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
# Legacy single-operator mode only; do not use for creator self-service.
ROBLOX_OPEN_CLOUD_API_KEY=
# Register Ropad's Roblox OAuth app. This connection verifies creator identity;
# it does not grant place-publishing permission. Secrets stay on the server.
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=https://ropad.fun/roblox/oauth/callback
# Each creator needs their own scoped Roblox credential. Reference the matching
# server variable from their project grant; never put secret values in JSON.
# Forward added variables into the app container's environment or secret manager.
ROPAD_ROBLOX_CREATOR_EXAMPLE_KEY=
# Operator ceilings, not permission to spend or an automatic run trigger.
ROPAD_BUILD_OUTPUT_TOKENS=6000
ROPAD_BUILD_PLAN_CAP_USD=0.75
ROPAD_AGENT_MAX_BUDGET_USD=1
